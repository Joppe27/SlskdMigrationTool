<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SlskdMigrationTool.App.App"
             RequestedThemeVariant="Default">
    <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.Styles>
        <FluentTheme />
        <Style Selector="Button.LightPurple">
            <Setter Property="BorderBrush" Value="MediumPurple" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="#fbf5ff" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.DarkPurple">
            <Setter Property="BorderBrush" Value="MediumPurple" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="BlueViolet" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.LightPurple:disabled /template/ ContentPresenter">
            <Setter Property="BorderBrush" Value="MediumPurple" />
        </Style>
        <Style Selector="Button.DarkPurple:disabled /template/ ContentPresenter">
            <Setter Property="BorderBrush" Value="MediumPurple" />
        </Style>
        <Style Selector="CheckBox.LightPurple /template/ Border#NormalRectangle">
            <Setter Property="BorderBrush" Value="MediumPurple" />
        </Style>
        <Style Selector="CheckBox.LightPurple:pointerover /template/ Border#NormalRectangle">
            <Setter Property="Background" Value="LightGray" />
            <Setter Property="BorderBrush" Value="MediumPurple" />
        </Style>
        <Style Selector="CheckBox.LightPurple:pressed /template/ Border#NormalRectangle">
            <Setter Property="Background" Value="#f5e5ff" />
            <Setter Property="BorderBrush" Value="MediumPurple" />
        </Style>
        <Style Selector="CheckBox.LightPurple:checked /template/ Border#NormalRectangle">
            <Setter Property="Background" Value="#fbf5ff" />
            <Setter Property="BorderBrush" Value="MediumPurple" />
        </Style>
        <Style Selector="CheckBox.LightPurple:checked:pointerover /template/ Border#NormalRectangle">
            <Setter Property="Background" Value="LightGray" />
            <Setter Property="BorderBrush" Value="MediumPurple" />
        </Style>
        <Style Selector="CheckBox.LightPurple:checked:pressed /template/ Border#NormalRectangle">
            <Setter Property="Background" Value="#f5e5ff" />
            <Setter Property="BorderBrush" Value="MediumPurple" />
        </Style>
        <Style Selector="CheckBox.LightPurple:checked /template/ Path#CheckGlyph">
            <Setter Property="Fill" Value="MediumPurple" />
        </Style>
        <Style Selector="TabItem.DarkPurple:selected /template/ Border#PART_SelectedPipe">
            <Setter Property="Background" Value="BlueViolet"/>
        </Style>
        <Style Selector="Svg.LoadingRotation">
            <Style.Animations>
                <Animation Duration="0:0:1.3" IterationCount="INFINITE">
                    <KeyFrame Cue="0%">
                        <Setter Property="RotateTransform.Angle" Value="0" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="RotateTransform.Angle" Value="360" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </Application.Styles>
    <Application.Resources>
        <x:Double x:Key="CheckBoxMinHeight">20</x:Double>
        <FontFamily x:Key="Mono">avares://SlskdMigrationTool.App/JetBrainsMono-Medium.ttf#JetBrains Mono</FontFamily>
        <Animation x:Key="ErrorAnimation" x:SetterTargetType="Svg" Duration="0:0:1.0" IterationCount="4">
            <KeyFrame Cue="0%">
                <Setter Property="Opacity" Value="1.0" />
            </KeyFrame>
            <KeyFrame Cue="49%">
                <Setter Property="Opacity" Value="1.0" />
            </KeyFrame>
            <KeyFrame Cue="50%">
                <Setter Property="Opacity" Value="0.0" />
            </KeyFrame>
            <KeyFrame Cue="100%">
                <Setter Property="Opacity" Value="0.0" />
            </KeyFrame>
        </Animation>
    </Application.Resources>
</Application>